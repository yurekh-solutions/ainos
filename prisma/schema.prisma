generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String              @id @default(uuid())
  name               String
  logoUrl            String?             @map("logo_url")
  gstNumber          String?             @map("gst_number")
  taxId              String?             @map("tax_id")
  address            String?
  email              String?
  phone              String?
  website            String?
  country            String?
  state              String?
  currency           String?             @default("INR")
  gstinStateCode     String?             @map("gstin_state_code")
  companyType        String?             @map("company_type")
  uploadedDocs       Json?               @map("uploaded_docs")
  docsVerified       Boolean             @default(false) @map("docs_verified")
  docsVerifiedAt     DateTime?           @map("docs_verified_at")
  docsVerifiedBy     String?             @map("docs_verified_by")
  bankName           String?             @map("bank_name")
  bankAccountNumber  String?             @map("bank_account_number")
  bankIfscCode       String?             @map("bank_ifsc_code")
  createdBy          String              @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // ONBOARDING STATUS TRACKING
  onboardingStatus   String              @default("pending") @map("onboarding_status") // pending, docs_submitted, under_review, approved, rejected, suspended
  onboardingSubmittedAt DateTime?        @map("onboarding_submitted_at")
  onboardingRejectionReason String?      @map("onboarding_rejection_reason")
  onboardingReviewedAt DateTime?         @map("onboarding_reviewed_at")
  onboardingReviewedBy String?           @map("onboarding_reviewed_by")
  uploadToken        String?             @unique @map("upload_token")
  totalDocsUploaded  Int                 @default(0) @map("total_docs_uploaded")
  totalDocsApproved  Int                 @default(0) @map("total_docs_approved")
  
  // TOOL ACCESS LEVELS (0=locked, 1=basic, 2=subscribed, 3=premium)
  autoBlog           Int                 @default(0) @map("auto_blog_level")
  invoiceGen         Int                 @default(0) @map("invoice_gen_level")
  crmAccess          Int                 @default(0) @map("crm_access_level")
  inventoryMgmt      Int                 @default(0) @map("inventory_mgmt_level")
  hrPayroll          Int                 @default(0) @map("hr_payroll_level")
  emailMarketing     Int                 @default(0) @map("email_marketing_level")
  aiAssistant        Int                 @default(0) @map("ai_assistant_level")
  websiteGen         Int                 @default(0) @map("website_gen_level")
  
  // SUBSCRIPTION STATUS
  subscriptionStatus String              @default("inactive") @map("subscription_status")
  subscriptionEndsAt DateTime?           @map("subscription_ends_at")
  
  aiChatSessions     AIChatSession[]
  attendance         Attendance[]
  automations        Automation[]
  blogPosts          BlogPost[]
  blogSchedules      BlogSchedule[]
  blogSubscriptions  BlogSubscription[]
  calendarEvents     CalendarEvent[]
  candidates         Candidate[]
  complianceTasks    ComplianceTask[]
  connectedWebsites  ConnectedWebsite[]
  contacts           Contact[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  creditPurchases    CreditPurchase[]
  customers          Customer[]
  deals              Deal[]
  documents          Document[]
  emailCampaigns     EmailCampaign[]
  employees          Employee[]
  expenses           Expense[]
  followUps          FollowUp[]
  generatedSites     GeneratedSite[]
  helpdeskTickets    HelpdeskTicket[]
  invoices           Invoice[]
  knowledgeArticles  KnowledgeArticle[]
  leads              Lead[]
  leaveRequests      LeaveRequest[]
  notifications      Notification[]
  payrollRuns        PayrollRun[]
  products           Product[]
  projects           Project[]
  purchaseOrders     PurchaseOrder[]
  quotes             Quote[]
  salesOrders        SalesOrder[]
  serviceRequests    ServiceRequest[]
  stockItems         StockItem[]
  subscriptions      Subscription[]
  tasks              Task[]
  timesheets         Timesheet[]
  toolRuns           ToolRun[]
  toolActivations    ToolActivation[]
  users              User[]
  vendors            Vendor[]
  warehouses         Warehouse[]
  deliveryChallans   DeliveryChallan[]
  invoiceTemplates   InvoiceTemplate[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  recurringInvoices  RecurringInvoice[]
  bankAccounts       BankAccount[]
  bankTransactions   BankTransaction[]
  gstFilings         GstFiling[]
  gstReconImports    GstReconImport[]
  onboardingAudits   OnboardingAudit[]
  onlineStores       OnlineStore[]
  ecomCategories     EcomCategory[]
  ecomProducts       EcomProduct[]
  shoppingCarts      ShoppingCart[]
  ecomOrders         EcomOrder[]
  productReviews     ProductReview[]
  couponCodes        CouponCode[]
  websites           Website[]
  webPages           WebPage[]
  webForms           WebForm[]
  webMenus           WebMenu[]
  posSessions        POSSession[]
  posOrders          POSOrder[]
  posCategories      POSCategory[]
  posProducts        POSProduct[]
  workCenters        WorkCenter[]
  boms               BOM[]
  manufacturingOrders ManufacturingOrder[]
  workOrders         WorkOrder[]
  qualityChecks      QualityCheck[]
  scrapOrders        ScrapOrder[]
  serviceJobs        ServiceJob[]
  assets             Asset[]
  maintenanceTasks   MaintenanceTask[]
  vehicles           Vehicle[]
  vehicleLogs        VehicleLog[]
  repairOrders       RepairOrder[]
  rentalOrders       RentalOrder[]
  approvalRequests   ApprovalRequest[]
  shifts             Shift[]
  surveys            Survey[]
  events             Event[]
  auditLogs          AuditLog[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  googleId  String?  @unique @map("google_id")
  image     String?
  role      String   @default("user")
  isAdmin   Boolean  @default(false) @map("is_admin")
  companyId String?  @map("company_id")
  phone     String?
  address   String?
  country   String?
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  password  String?
  resetToken String? @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  company   Company? @relation(fields: [companyId], references: [id])

  @@map("users")
}

// ── OTP / verification ledger ──────────────────────────────────────────────
// One row per code issued. Codes are stored hashed, never in plain text.
// purpose: signup_email | signup_phone | reset_email | reset_request
model VerificationCode {
  id         String    @id @default(uuid())
  channel    String    // email | phone
  target     String    // normalised email address or E.164 phone number
  purpose    String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([channel, target, purpose])
  @@index([expiresAt])
  @@map("verification_codes")
}

model Contact {
  id            String    @id @default(uuid())
  name          String
  email         String?
  phone         String?
  company       String?
  tags          Json?
  source        String    @default("manual")
  dealValue     Float?    @map("deal_value")
  stage         String    @default("lead")
  lastContacted DateTime? @map("last_contacted")
  notes         String?
  createdBy     String    @map("created_by")
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  companyRef    Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("contacts")
}

model Lead {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  company    String?
  source     String   @default("manual")
  status     String   @default("new")
  score      Int      @default(0)
  notes      String?
  assignedTo String?  @map("assigned_to")
  companyId  String?  @map("company_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  companyRef Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("leads")
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  gstNumber     String?  @map("gst_number")
  panNumber     String?  @map("pan_number")
  state         String?
  pincode       String?
  status        String   @default("active")
  notes         String?
  companyId     String?  @map("company_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  companyRef    Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("customers")
}

model Deal {
  id            String    @id @default(uuid())
  title         String
  value         Float?
  currency      String    @default("USD")
  stage         String    @default("new")
  probability   Int       @default(0)
  expectedClose DateTime? @map("expected_close")
  source        String?
  ownerId       String?   @map("owner_id")
  notes         String?
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  companyRef    Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("deals")
}

model Employee {
  id          String    @id @default(uuid())
  name        String
  email       String?   @unique
  phone       String?
  department  String?
  position    String?
  salary      Float?
  joinDate    DateTime? @map("join_date")
  status      String    @default("active")
  address     String?
  bankDetails Json?     @map("bank_details")
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("employees")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String?  @unique
  description String?
  price       Float?
  cost        Float?
  costPrice   Float?   @map("cost_price")
  mrp         Float?
  hsnCode     String?  @map("hsn_code")
  barcode     String?  @unique
  gstRate     Float?   @map("gst_rate")
  category    String?
  stock       Int      @default(0)
  unit        String?  @default("pcs")
  status      String   @default("active")
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("products")
}

model Invoice {
  id                String    @id @default(uuid())
  invoiceNumber     String    @unique @map("invoice_number")
  customerId        String?   @map("customer_id")
  customerName      String?   @map("customer_name")
  items             Json?
  subtotal          Float?
  tax               Float?
  discount          Float?    @default(0)
  total             Float?
  status            String    @default("draft")
  dueDate           DateTime? @map("due_date")
  paidDate          DateTime? @map("paid_date")
  notes             String?
  companyId         String?   @map("company_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by")
  customerAddress   String?   @map("customer_address")
  customerEmail     String?   @map("customer_email")
  customerGstNumber String?   @map("customer_gst_number")
  invoiceDate       DateTime? @map("invoice_date")
  taxRate           Float?    @map("tax_rate")
  taxTotal          Float?    @map("tax_total")
  totalAmount       Float?    @map("total_amount")
  // GST split fields
  cgstAmount        Float?    @map("cgst_amount")
  sgstAmount        Float?    @map("sgst_amount")
  igstAmount        Float?    @map("igst_amount")
  billingType       String?   @map("billing_type")
  supplyType        String?   @map("supply_type")
  discountAmount    Float?    @map("discount_amount")
  discountType      String?   @map("discount_type")
  profitAmount      Float?    @map("profit_amount")
  // GST compliance add-ons
  utgstAmount       Float?    @map("utgst_amount")
  currency          String?   @default("INR")
  currencyRate      Float?    @map("currency_rate")
  tdsAmount         Float?    @default(0) @map("tds_amount")
  tdsSection        String?   @map("tds_section")
  tcsAmount         Float?    @default(0) @map("tcs_amount")
  tcsSection        String?   @map("tcs_section")
  isExport          Boolean?  @map("is_export")
  isSez             Boolean?  @map("is_sez")
  hsnSummary        Json?     @map("hsn_summary")
  // E-Invoice fields
  einvoiceIrn       String?   @map("einvoice_irn")
  einvoiceQr        String?   @map("einvoice_qr")
  einvoiceAck       String?   @map("einvoice_ack")
  // E-Way Bill fields
  ewayBillNo        String?   @map("eway_bill_no")
  ewayBillDate      DateTime? @map("eway_bill_date")
  ewayBillValid     DateTime? @map("eway_bill_valid")
  transportDocNo    String?   @map("transport_doc_no")
  vehicleNo         String?   @map("vehicle_no")
  // Payment tracking
  paymentMethod     String?   @map("payment_method")
  payments          Json?
  paidAmount        Float?    @map("paid_amount")
  placeOfSupply     String?   @map("place_of_supply")
  customerState     String?   @map("customer_state")
  customerPan       String?   @map("customer_pan")
  // Digital Signature fields
  signatureImage    String?   @map("signature_image") // base64 or URL
  signatureType     String?   @map("signature_type") // upload | draw | none
  signatureDate     DateTime? @map("signature_date")
  // Custom dynamic fields from template
  customFields      Json?     @map("custom_fields") // {poNumber: "PO-123", validityDate: "2026-12-31", ...}
  company           Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdBy])
  @@map("invoices")
}

model Quote {
  id           String    @id @default(uuid())
  quoteNumber  String    @unique @map("quote_number")
  customerId   String?   @map("customer_id")
  customerName String?   @map("customer_name")
  items        Json?
  subtotal     Float?
  tax          Float?
  discount     Float?    @default(0)
  total        Float?
  status       String    @default("draft")
  validUntil   DateTime? @map("valid_until")
  notes        String?
  companyId    String?   @map("company_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  companyRef   Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("quotes")
}

model SalesOrder {
  id           String    @id @default(uuid())
  orderNumber  String    @unique @map("order_number")
  customerId   String?   @map("customer_id")
  customerName String?   @map("customer_name")
  items        Json?
  subtotal     Float?
  tax          Float?
  discount     Float?    @default(0)
  total        Float?
  status       String    @default("pending")
  orderDate    DateTime? @map("order_date")
  deliveryDate DateTime? @map("delivery_date")
  notes        String?
  companyId    String?   @map("company_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  companyRef   Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("sales_orders")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     String    @unique @map("po_number")
  vendorId     String?   @map("vendor_id")
  vendorName   String?   @map("vendor_name")
  items        Json?
  subtotal     Float?
  tax          Float?
  discount     Float?    @default(0)
  total        Float?
  status       String    @default("draft")
  orderDate    DateTime? @map("order_date")
  expectedDate DateTime? @map("expected_date")
  notes        String?
  companyId    String?   @map("company_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  companyRef   Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("purchase_orders")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  assignedTo  String?   @map("assigned_to")
  projectId   String?   @map("project_id")
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("tasks")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("active")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  budget      Float?
  managerId   String?   @map("manager_id")
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("projects")
}

model Expense {
  id              String    @id @default(uuid())
  title           String?
  category        String
  description     String?
  vendor          String?
  amount          Float
  taxAmount       Float     @default(0) @map("tax_amount")
  paymentMethod   String    @default("cash") @map("payment_method") // cash | upi | card | bank | cheque | credit
  date            DateTime
  receipt         String?
  status          String    @default("pending") // pending | approved | rejected | reimbursed
  submittedBy     String?   @map("submitted_by")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  reimbursedAt    DateTime? @map("reimbursed_at")
  companyId       String?   @map("company_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  company         Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, status])
  @@map("expenses")
}

model Vendor {
  id         String   @id @default(uuid())
  name       String
  email      String?
  phone      String?
  company    String?
  address    String?
  gstNumber  String?  @map("gst_number")
  status     String   @default("active")
  notes      String?
  companyId  String?  @map("company_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  companyRef Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("vendors")
}

model StockItem {
  id           String   @id @default(uuid())
  name         String
  sku          String?
  quantity     Int      @default(0)
  unit         String?  @default("pcs")
  minStock     Int      @default(0) @map("min_stock")
  maxStock     Int?     @map("max_stock")
  location     String?
  status       String   @default("active")
  companyId    String?  @map("company_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  reorderLevel Int      @default(0) @map("reorder_level")
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("stock_items")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String?
  manager   String?
  capacity  Int?
  status    String   @default("active")
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("warehouses")
}

model BlogPost {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  content       String?
  excerpt       String?
  author        String?
  authorName    String?        @map("author_name")
  status        String         @default("draft")
  publishedAt   DateTime?      @map("published_at")
  tags          Json?
  companyId     String?        @map("company_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  category      String?
  featuredImage String?        @map("featured_image")
  scheduledAt   DateTime?      @map("scheduled_at")
  // Analytics fields (added so blog-analytics + conversion-tracking routes compile)
  views         Int            @default(0)
  avgTimeOnPage Float?         @map("avg_time_on_page")
  ctaClicks     Int            @default(0) @map("cta_clicks")
  conversions   Int            @default(0)
  bounceRate    Float?         @map("bounce_rate")
  company       Company?       @relation(fields: [companyId], references: [id])
  schedules     BlogSchedule[]

  @@index([companyId])
  @@map("blog_posts")
}

model EmailCampaign {
  id         String    @id @default(uuid())
  name       String
  subject    String?
  content    String?
  recipients Json?
  status     String    @default("draft")
  sentAt     DateTime? @map("sent_at")
  sentCount  Int       @default(0) @map("sent_count")
  companyId  String?   @map("company_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  company    Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("email_campaigns")
}

model HelpdeskTicket {
  id           String   @id @default(uuid())
  ticketNumber String   @unique @map("ticket_number")
  subject      String
  description  String?
  priority     String   @default("medium")
  status       String   @default("open")
  category     String?
  assignedTo   String?  @map("assigned_to")
  customerId   String?  @map("customer_id")
  resolution   String?
  companyId    String?  @map("company_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("helpdesk_tickets")
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  content   String?
  category  String?
  tags      Json?
  author    String?
  status    String   @default("published")
  views     Int      @default(0)
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("knowledge_articles")
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  location    String?
  attendees   Json?
  status      String    @default("scheduled")
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("calendar_events")
}

model Document {
  id              String    @id @default(uuid())
  name            String
  type            String?
  url             String?
  size            Int?
  category        String?
  tags            Json?
  notes           String?
  expiryDate      DateTime? @map("expiry_date")
  uploadedBy      String?   @map("uploaded_by")
  companyId       String?   @map("company_id")
  createdAt       DateTime  @default(now()) @map("created_at")
