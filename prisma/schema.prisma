  @@unique([websiteId, slug])
  @@index([companyId])
  @@map("web_pages")
}

model WebForm {
  id          String   @id @default(uuid())
  name        String
  fields      Json?    // [{label, type, required, options}]
  submissions Json?    // stored form submissions
  websiteId   String?  @map("website_id")
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  website     Website? @relation(fields: [websiteId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("web_forms")
}

model WebMenu {
  id        String   @id @default(uuid())
  name      String
  items     Json?    // [{label, url, order, children}]
  websiteId String?  @map("website_id")
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  website   Website? @relation(fields: [websiteId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("web_menus")
}

// ═══════════════════════════════════════════
// PHASE 1: POINT OF SALE (POS) MODULE
// ═══════════════════════════════════════════

model POSSession {
  id           String    @id @default(uuid())
  name         String
  status       String    @default("closed") // open, closed
  openedAt     DateTime? @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openedBy     String?   @map("opened_by")
  closedBy     String?   @map("closed_by")
  openingCash  Float     @default(0) @map("opening_cash")
  closingCash  Float?    @map("closing_cash")
  totalSales   Float     @default(0) @map("total_sales")
  totalOrders  Int       @default(0) @map("total_orders")
  notes        String?
  companyId    String?   @map("company_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  orders       POSOrder[]
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("pos_sessions")
}

model POSOrder {
  id           String    @id @default(uuid())
  orderNumber  String    @unique @map("order_number")
  items        Json?
  subtotal     Float?
  tax          Float?
  discount     Float?    @default(0)
  total        Float?
  status       String    @default("completed") // completed, voided, refunded
  paymentMethod String   @default("cash") @map("payment_method") // cash, card, upi
  amountPaid   Float?    @map("amount_paid")
  changeAmount Float?    @map("change_amount")
  customerName String?   @map("customer_name")
  notes        String?
  sessionId    String?   @map("session_id")
  companyId    String?   @map("company_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  session      POSSession? @relation(fields: [sessionId], references: [id])
  company      Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("pos_orders")
}

model POSCategory {
  id        String   @id @default(uuid())
  name      String
  color     String?  // hex color for POS UI
  sortOrder Int      @default(0) @map("sort_order")
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  products  POSProduct[]
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("pos_categories")
}

model POSProduct {
  id          String   @id @default(uuid())
  name        String
  sku         String?
  barcode     String?  @unique
  price       Float
  categoryId  String?  @map("category_id")
  imageUrl    String?  @map("image_url")
  isInStock   Boolean  @default(true) @map("is_in_stock")
  quickKey    String?  @map("quick_key") // shortcut key on POS screen
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  category    POSCategory? @relation(fields: [categoryId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([categoryId])
  @@map("pos_products")
}

// ═══════════════════════════════════════════
// PHASE 1: MANUFACTURING (MRP) MODULE
// ═══════════════════════════════════════════

model WorkCenter {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  description String?
  capacity    Int?     // units per hour
  costPerHour Float?   @map("cost_per_hour")
  status      String   @default("active") // active, maintenance, inactive
  location    String?
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workOrders  WorkOrder[]
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("work_centers")
}

model BOM {
  id          String   @id @default(uuid())
  name        String
  code        String?  @unique
  product     String   // finished product name
  productId   String?  @map("product_id") // link to Product model
  quantity    Float    @default(1) // output quantity
  components  Json?    // [{productId, name, quantity, unit}]
  version     Int      @default(1)
  status      String   @default("active") // active, draft, archived
  notes       String?
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  orders      ManufacturingOrder[]
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("boms")
}

model ManufacturingOrder {
  id            String    @id @default(uuid())
  moNumber      String    @unique @map("mo_number")
  bomId         String?   @map("bom_id")
  product       String
  quantity      Float
  plannedDate   DateTime? @map("planned_date")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  status        String    @default("draft") // draft, confirmed, in_progress, done, cancelled
  priority      String    @default("medium")
  components    Json?     // consumed materials
  producedQty   Float     @default(0) @map("produced_qty")
  scrappedQty   Float     @default(0) @map("scrapped_qty")
  notes         String?
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  bom           BOM?      @relation(fields: [bomId], references: [id])
  workOrders    WorkOrder[]
  company       Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("manufacturing_orders")
}

model WorkOrder {
  id            String    @id @default(uuid())
  moId          String?   @map("mo_id")
  name          String
  workCenterId  String?   @map("work_center_id")
  plannedHours  Float?    @map("planned_hours")
  actualHours   Float?    @map("actual_hours")
  status        String    @default("pending") // pending, in_progress, done, cancelled
  assignedTo    String?   @map("assigned_to")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  notes         String?
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  mo            ManufacturingOrder? @relation(fields: [moId], references: [id])
  workCenter    WorkCenter? @relation(fields: [workCenterId], references: [id])
  company       Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([moId])
  @@map("work_orders")
}

model QualityCheck {
  id          String    @id @default(uuid())
  title       String
  type        String    @default("inspection") // inspection, test, audit
  moId        String?   @map("mo_id")
  productId   String?   @map("product_id")
  checklist   Json?     // [{item, pass, notes}]
  status      String    @default("pending") // pending, passed, failed
  inspector   String?   @map("inspector")
  inspectedAt DateTime? @map("inspected_at")
  notes       String?
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([moId])
  @@map("quality_checks")
}

model ScrapOrder {
  id          String   @id @default(uuid())
  moId        String?  @map("mo_id")
  product     String
  quantity    Float
  reason      String?
  cost        Float?   // loss value
  disposedAt  DateTime? @map("disposed_at")
  companyId   String?  @map("company_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("scrap_orders")
}

// ── Field service ────────────────────────
// One row per on-site job. status: scheduled | in_progress | completed | cancelled
model ServiceJob {
  id             String    @id @default(uuid())
  jobNumber      String?   @map("job_number")
  title          String
  customerName   String?   @map("customer_name")
  contactPhone   String?   @map("contact_phone")
  address        String?
  technician     String?
  priority       String    @default("normal") // low | normal | high | urgent
  status         String    @default("scheduled")
  scheduledFor   DateTime? @map("scheduled_for")
  completedAt    DateTime? @map("completed_at")
  estimatedHours Float?    @map("estimated_hours")
  labourCost     Float     @default(0) @map("labour_cost")
  partsCost      Float     @default(0) @map("parts_cost")
  description    String?
  notes          String?
  companyId      String?   @map("company_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, scheduledFor])
  @@map("service_jobs")
}

// ── Maintenance ──────────────────────────
// Assets are the things that need upkeep; tasks are the scheduled services.
model Asset {
  id            String            @id @default(uuid())
  name          String
  code          String?
  category      String? // equipment | hvac | electrical | it | other
  location      String?
  serialNumber  String?           @map("serial_number")
  assignedTo    String?           @map("assigned_to")
  purchasedAt   DateTime?         @map("purchased_at")
  warrantyUntil DateTime?         @map("warranty_until")
  status        String            @default("active") // active | under_maintenance | retired
  notes         String?
  companyId     String?           @map("company_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  company       Company?          @relation(fields: [companyId], references: [id])
  tasks         MaintenanceTask[]

  @@index([companyId])
  @@map("assets")
}

model MaintenanceTask {
  id          String    @id @default(uuid())
  assetId     String    @map("asset_id")
  title       String
  type        String    @default("preventive") // preventive | corrective | inspection
  status      String    @default("planned") // planned | in_progress | done | skipped
  dueAt       DateTime? @map("due_at")
  completedAt DateTime? @map("completed_at")
  technician  String?
  cost        Float     @default(0)
  notes       String?
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([assetId])
  @@index([companyId, status])
  @@map("maintenance_tasks")
}

// ── Fleet ────────────────────────────────
model Vehicle {
  id             String       @id @default(uuid())
  name           String
  registration   String?
  type           String       @default("car") // car | van | truck | bike
  driver         String?
  odometer       Float?
  insuranceUntil DateTime?    @map("insurance_until")
  fitnessUntil   DateTime?    @map("fitness_until")
  status         String       @default("active") // active | in_service | retired
  notes          String?
  companyId      String?      @map("company_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  company        Company?     @relation(fields: [companyId], references: [id])
  logs           VehicleLog[]

  @@index([companyId])
  @@map("vehicles")
}

model VehicleLog {
  id        String   @id @default(uuid())
  vehicleId String   @map("vehicle_id")
  type      String   @default("fuel") // fuel | service | repair | insurance | other
  date      DateTime
  litres    Float?
  cost      Float    @default(0)
  odometer  Float?
  vendor    String?
  notes     String?
  companyId String?  @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([vehicleId])
  @@map("vehicle_logs")
}

model RepairOrder {
  id            String    @id @default(uuid())
  orderNumber   String    @unique @map("order_number")
  customerId    String?   @map("customer_id")
  customerName  String    @map("customer_name")
  customerPhone String?   @map("customer_phone")
  customerEmail String?   @map("customer_email")
  deviceName    String    @map("device_name")
  serialNumber  String?   @map("serial_number")
  underWarranty Boolean   @default(false) @map("under_warranty")
  issue         String?
  diagnosis     String?
  resolution    String?
  status        String    @default("received") // received | diagnosed | in_progress | awaiting_parts | ready | delivered | cancelled
  priority      String    @default("normal") // low | normal | high | urgent
  technician    String?
  laborCost     Float     @default(0) @map("labor_cost")
  partsCost     Float     @default(0) @map("parts_cost")
  totalCost     Float     @default(0) @map("total_cost")
  receivedAt    DateTime  @default(now()) @map("received_at")
  promisedAt    DateTime? @map("promised_at")
  completedAt   DateTime? @map("completed_at")
  deliveredAt   DateTime? @map("delivered_at")
  notes         String?
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lines         RepairLine[]
  company       Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("repair_orders")
}

model RepairLine {
  id          String      @id @default(uuid())
  repairId    String      @map("repair_id")
  kind        String      @default("part") // part | labor | service
  description String
  quantity    Float       @default(1)
  unitPrice   Float       @default(0) @map("unit_price")
  amount      Float       @default(0)
  repair      RepairOrder @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
  @@map("repair_lines")
}

model RentalOrder {
  id            String    @id @default(uuid())
  orderNumber   String    @unique @map("order_number")
  customerName  String    @map("customer_name")
  customerEmail String?   @map("customer_email")
  customerPhone String?   @map("customer_phone")
  itemName      String    @map("item_name")
  itemRef       String?   @map("item_ref")
  quantity      Decimal   @default(1) @db.Decimal(10, 2)
  period        String    @default("day") // hour | day | week | month
  unitPrice     Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  rentalFee     Decimal   @default(0) @map("rental_fee") @db.Decimal(14, 2)
  deposit       Decimal   @default(0) @db.Decimal(14, 2)
  lateFee       Decimal   @default(0) @map("late_fee") @db.Decimal(14, 2)
  total         Decimal   @default(0) @db.Decimal(14, 2)
  status        String    @default("draft") // draft | confirmed | out | returned | cancelled
  returnedAt    DateTime? @map("returned_at")
  notes         String?
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  company       Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("rental_orders")
}

model ApprovalRequest {
  id            String    @id @default(uuid())
  title         String
  category      String    @default("purchase") // purchase | expense | leave | budget | other
  amount        Decimal   @default(0) @db.Decimal(14, 2)
  requesterName String    @map("requester_name")
  approverName  String?   @map("approver_name")
  description   String?
  status        String    @default("pending") // pending | approved | refused | cancelled
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")
  createdById   String?   @map("created_by_id")
  decidedById   String?   @map("decided_by_id")
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  company       Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("approval_requests")
}

model Shift {
  id           String    @id @default(uuid())
  employeeName String    @map("employee_name")
  role         String?
  startAt      DateTime  @map("start_at")
  endAt        DateTime  @map("end_at")
  location     String?
  status       String    @default("planned") // planned | confirmed | done | absent | cancelled
  notes        String?
  companyId    String?   @map("company_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  company      Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([startAt])
  @@map("shifts")
}

model Survey {
  id          String    @id @default(uuid())
  title       String
  description String?
  audience    String?   // customers | employees | vendors
  status      String    @default("draft") // draft | live | closed
  companyId   String?   @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
  company     Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("surveys")
}

model SurveyQuestion {
  id       String  @id @default(uuid())
  surveyId String  @map("survey_id")
  prompt   String
  kind     String  @default("rating") // rating | text | choice | yesno
  options  Json?
  required Boolean @default(true)
  position Int     @default(0)
  survey   Survey  @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id             String   @id @default(uuid())
  surveyId       String   @map("survey_id")
  respondentName String?  @map("respondent_name")
  answers        Json?
  score          Float?
  submittedAt    DateTime @default(now()) @map("submitted_at")
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("survey_responses")
}

model Event {
  id            String    @id @default(uuid())
  title         String
  category      String    @default("conference")
  description   String?
  startAt       DateTime  @map("start_at")
  endAt         DateTime? @map("end_at")
  location      String?
  capacity      Int       @default(0)
  ticketPrice   Decimal   @default(0) @map("ticket_price") @db.Decimal(14, 2)
  status        String    @default("draft") // draft | published | closed | cancelled
  companyId     String?   @map("company_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  registrations EventRegistration[]
  company       Company?  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([startAt])
  @@map("events")
}

model EventRegistration {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  attendeeName  String   @map("attendee_name")
  attendeeEmail String?  @map("attendee_email")
  seats         Int      @default(1)
  amount        Decimal  @default(0) @db.Decimal(14, 2)
  status        String   @default("confirmed") // confirmed | cancelled
  registeredAt  DateTime @default(now()) @map("registered_at")
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_registrations")
}

/// Append-only trail of who changed what, for every operational record.
/// Actor identity is stored as plain values (no FK) so the history survives
/// user deletion and stays readable years later.
model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  entity     String // rental | approval | shift | survey | event | registration
  entityId   String   @map("entity_id")
  action     String // created | updated | deleted | approved | refused | returned | handover
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  summary    String?
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}
