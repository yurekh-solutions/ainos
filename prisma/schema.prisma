  createdAt   DateTime  @default(now()) @map("created_at")
  paidAt      DateTime? @map("paid_at")
  company     Company   @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("credit_purchases")
}

model ConnectedWebsite {
