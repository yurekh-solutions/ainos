  @@index([companyId])
  @@map("bank_accounts")
}

model BankTransaction {
  id            String    @id @default(uuid())
  accountId     String    @map("account_id")
  date          DateTime
  description   String?
  debit         Float     @default(0)
  credit        Float     @default(0)
  balance       Float?
  reference     String?
