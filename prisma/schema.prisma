  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  company       Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("debit_notes")
}

// ═══════════════════════════════════════════
// RECURRING INVOICES
