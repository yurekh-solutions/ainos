  company       Company?  @relation(fields: [companyId], references: [id])

  @@index([accountId])
  @@index([companyId])
  @@index([date])
  @@map("bank_transactions")
}

// ═══════════════════════════════════════════
// GST FILING TRACKER + 2B RECONCILIATION
// ═══════════════════════════════════════════

model GstFiling {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  period    String    // e.g. "2026-04" or "Q1-FY26"
  type      String    // GSTR1 | GSTR3B
  status    String    @default("pending") // pending | filed
  filedAt   DateTime? @map("filed_at")
  payload   Json?     // exported GSTN json snapshot for the period
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, period, type])
  @@index([companyId])
  @@map("gst_filings")
}

model GstReconImport {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  rawJson     Json     @map("raw_json") // GSTR-2B portal file as downloaded
  resultJson  Json?    @map("result_json") // cached reconciliation result
  createdAt   DateTime @default(now()) @map("created_at")
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("gst_recon_imports")
}

// ═══════════════════════════════════════════
// ONBOARDING AUDIT LOG
// ═══════════════════════════════════════════

model OnboardingAudit {
