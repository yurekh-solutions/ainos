# ─── Database (Aiven PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:port/ainos?sslmode=require"

# ─── NextAuth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Redis (optional - for caching & queues) ───────────────────────────
# REDIS_URL="redis://default:password@host:port"

# ─── Razorpay (optional - deferred) ──────────────────────────────────
# RAZORPAY_KEY_ID="your-razorpay-key"
# RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ─── Admin ─────────────────────────────────────────────────────────────
# ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# ─── UPI (optional) ───────────────────────────────────────────────────
# NEXT_PUBLIC_UPI_ID="your-upi-id"

# ─── AI Generation (Groq primary + Gemini + Cloudflare + HF + Pollinations) ─
# Free tier providers — keys are optional. Fallback chain:
#   Groq → Gemini → Cloudflare → HuggingFace → Pollinations
# Each provider is auto-activated when its keys are present.

# ── Groq (primary) ── 30 req/min/key, super fast, free — https://console.groq.com
# GROQ_API_KEY="gsk_xxx"
# GROQ_API_KEYS="gsk_aaa,gsk_bbb,gsk_ccc,gsk_ddd"
# GROQ_TEXT_MODEL="openai/gpt-oss-20b"
# GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# ── Gemini (optional 2nd) ── 15 req/min free — https://aistudio.google.com/app/apikey
# Powers image/video analysis (vision) + reliable caption/blog generation.
# GEMINI_API_KEY="AIzaSy_your_key"
# GEMINI_API_KEYS="key1,key2,key3,key4"
# GEMINI_MODEL="gemini-3.6-flash"

# ── Cloudflare Workers AI (optional 3rd) ── 10K neurons/day free — https://dash.cloudflare.com
# CLOUDFLARE_API_KEY="your-cf-api-token"
# CLOUDFLARE_API_KEYS="token1,token2"
# CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
# CLOUDFLARE_ACCOUNT_EMAIL="you@example.com"
# CLOUDFLARE_TEXT_MODEL="@cf/meta/llama-3.1-8b-instruct"
# CLOUDFLARE_VISION_MODEL="@cf/llava-hf/llava-1.5-7b-hf"

# ── HuggingFace Inference (optional 4th) ── 1K req/day free — https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY="hf_xxx"
# HUGGINGFACE_API_KEYS="hf_token1,hf_token2"
# HUGGINGFACE_TEXT_MODEL="meta-llama/Llama-3.2-3B-Instruct"
# HUGGINGFACE_VISION_MODEL="Salesforce/blip-image-captioning-large"

# ─── Email Notifications (Resend) ─────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000 emails/month
# Used for: Blog publish notifications, user alerts
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Transactional Email (Brevo) ─────────────────────────────────────
# Get your API key at https://app.brevo.com/settings/keys/api
# Free tier: 300 emails/day, no domain verification required
# Used for: Password reset emails, auth notifications
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# BREVO_FROM="AINOS <noreply@your-domain.com>"

# ─── Cloudinary (Document Storage) ────────────────────────────────────
# Create account at https://cloudinary.com — free tier: 25 GB storage, 25 GB bandwidth/mo
# Used for: Company document upload, preview thumbnails, verification workflow
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ─── OCR.space (Invoice Extraction) ───────────────────────────────────
# Get free API key at https://ocr.space/ocrapi — 25,000 requests/month
# Used for: Invoice upload & auto-extraction, document OCR
# OCR_SPACE_API_KEY="helloworld"  # Free tier key, replace with your own
